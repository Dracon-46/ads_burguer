@model List<TotemPWA.Models.ViewModels.CartItemViewModel>

@{
    ViewData["Title"] = "Carrinho";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="/css/cart.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body>
    <div class="cart-container">
        <h2>Seu Carrinho</h2>

        @if (!Model.Any())
        {
            <p class="empty-cart-message">Seu carrinho está vazio.</p>
            <div class="cart-actions-bottom empty-cart-actions">
                <a href="@Url.Action("TelaProduto", "Home")" class="btn btn-primary">Continuar Comprando</a>
            </div>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Produto</th>
                        <th>Quantidade</th>
                        <th>Preço Unitário</th>
                        <th>Total</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        var item = Model[i];
                        <tr style="--i: @(i);">
                            <td data-label="Produto">
                                @item.Name
                                @if (!string.IsNullOrEmpty(item.PersonalizationSummary))
                                {
                                    <br /><small class="personalization-summary">@item.PersonalizationSummary</small>
                                }
                            </td>
                            <td data-label="Quantidade">@item.Quantity</td>
                            <td data-label="Preço Unitário">R$ @item.Price.ToString("F2")</td>
                            <td data-label="Total">R$ @((item.Price * item.Quantity).ToString("F2"))</td>
                            <td data-label="Ações">
                                <div class="btn-group">
                                    <form asp-action="AddItem" asp-controller="Cart" method="post" style="display:inline;">
                                        <input type="hidden" name="cartItemId" value="@item.CartItemId" /> @* Passa o CartItemId *@
                                        <button type="submit" class="btn btn-sm btn-success" title="Adicionar Mais">+</button>
                                    </form>

                                    <form asp-action="DecreaseItem" asp-controller="Cart" method="post" style="display:inline;">
                                        <input type="hidden" name="cartItemId" value="@item.CartItemId" /> @* Passa o CartItemId *@
                                        <button type="submit" class="btn btn-sm btn-danger" title="Remover Unidade">−</button>
                                    </form>

                                    @* Use CustomerController e PersonalizarCombo para edição *@
                                    <form asp-action="PersonalizarProdutos" asp-controller="Customer" method="get" style="display:inline;">
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <input type="hidden" name="cartItemId" value="@item.CartItemId" /> @* Passa o CartItemId para edição *@
                                        <button type="submit" class="btn btn-sm btn-warning" title="Personalizar">
                                            <i class="fa-solid fa-pen"></i>
                                        </button>
                                    </form>

                                    @* Remova o item completamente, diferente de DecreaseItem *@
                                    <form asp-action="RemoveItem" asp-controller="Cart" method="post" style="display:inline;">
                                        <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                                        <button type="submit" class="btn btn-sm btn-info" title="Remover Item">
                                            <i class="fa-solid fa-xmark"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <p class="order-total">
                <strong>Total do Pedido:</strong> <span>R$ @Model.Sum(x => x.Price * x.Quantity).ToString("F2")</span>
            </p>

            <div class="cart-actions-bottom">
                <form asp-action="Clear" asp-controller="Cart" method="post" style="display:inline;">
                    <button class="btn btn-warning"><i class="fa-solid fa-trash-can"></i> Esvaziar Carrinho</button>
                </form>

                <a href="@Url.Action("TelaProduto", "Home")" class="btn btn-primary"><i class="fa-solid fa-cart-plus"></i> Continuar Comprando</a>
                <a href="@Url.Action("Cupom", "Home")" class="btn btn-success"><i class="fa-solid fa-cash-register"></i> Finalizar Pedido</a>
            </div>
        }
    </div>
</body>
</html>