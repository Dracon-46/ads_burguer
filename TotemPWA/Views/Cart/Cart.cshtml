@model List<TotemPWA.Models.ViewModels.CartItemViewModel>

@{
    ViewData["Title"] = "Carrinho";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/css/cart.css">
</head>
<body>
    
</body>
</html>
<h2>Seu Carrinho</h2>

@if (!Model.Any())
{
    <p>Seu carrinho está vazio.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Produto</th>
                <th>Quantidade</th>
                <th>Preço</th>
                <th>Total</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Quantity</td>
                    <td>R$ @item.Price.ToString("F2")</td>
                    <td>R$ @(item.Price * item.Quantity)</td>
                    <td>
                        <div class="btn-group">
                            <!-- Botão Adicionar Mais -->
                            <form asp-action="AddItem" method="post" style="display:inline;">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <button type="submit" class="btn btn-sm btn-success">+</button>
                            </form>

                            <!-- Botão Remover -->
                            <form asp-action="RemoveItem" method="post" style="display:inline;">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <button type="submit" class="btn btn-sm btn-danger">−</button>
                            </form>

                             <!-- Botão Personalizar -->
                            <form asp-action="Personalizar" asp-controller="Home" method="get" style="display:inline;">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <button type="submit" class="btn btn-sm btn-warning" title="Personalizar">
                                    <i class="fa-solid fa-pen"></i>
                                </button>
                            </form>
                        </div>
                    </td>

                </tr>
            }
        </tbody>
    </table>

    <p><strong>Total do Pedido:</strong> R$ @Model.Sum(x => x.Price * x.Quantity)</p>

    <form asp-action="Clear" method="post">
        <button class="btn btn-warning">Esvaziar Carrinho</button>
    </form>
}

<div class="mt-3">
    <a href="@Url.Action("TelaProduto", "Home")" class="btn btn-primary">Continuar Comprando</a>
    <a href="@Url.Action("Cupom", "Home")" class="btn btn-success">Finalizar Pedido</a>
</div>