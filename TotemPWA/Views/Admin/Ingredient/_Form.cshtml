@model TotemPWA.Models.Ingredient

<div class="form-group">
    <label asp-for="Name" class="control-label">Nome do Ingrediente:</label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="Price" class="control-label">Preço:</label>
    <input asp-for="Price" class="form-control" />
    <span asp-validation-for="Price" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="Limit" class="control-label">Limite:</label>
    <input asp-for="Limit" class="form-control" />
    <span asp-validation-for="Limit" class="text-danger"></span>
</div>