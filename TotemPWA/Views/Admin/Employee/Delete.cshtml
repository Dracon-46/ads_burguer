@model TotemPWA.Models.Employee

@{
    ViewData["Title"] = "Excluir Funcionário";
}

<h1>Excluir Funcionário</h1>

<h3>Tem certeza de que deseja excluir este funcionário?</h3>
<div>
    <h4>Funcionário</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @* Linha 16: Usando o operador null-forgiving (!) para suprimir o aviso, assumindo que Client.Name sempre estará disponível para fins de exibição de nome de coluna. *@
            @Html.DisplayNameFor(model => model.Client!.Name)
        </dt>
        <dd class="col-sm-10">
            @* Linha 19: Usando o operador null-conditional (?.) e null-coalescing (?? ) para exibir "N/A" se o cliente ou o nome do cliente for nulo. *@
            @(Model.Client?.Name ?? "N/A")
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Type)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Type)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.User)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.User)
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="ClientId" />
        <input type="submit" value="Excluir" class="btn btn-danger" /> |
        <a asp-action="List">Voltar para a Lista</a>
    </form>
</div>