@model TotemPWA.Models.Employee

@{
    ViewData["Title"] = "Excluir Funcionário";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="~/css/employee.css" />
</head>
<body>
    <div class="totem-container">
        <div class="totem-header">
            <h1>Excluir Funcionário</h1>
        </div>

        <div class="alert alert-warning">
            <h3><i class="fas fa-exclamation-triangle"></i> Tem certeza de que deseja excluir este funcionário?</h3>
            <p>Esta ação não pode ser desfeita.</p>
        </div>

        <div class="card mb-4">
            <div class="card-header bg-light">
                <h4>Detalhes do Funcionário</h4>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Cliente:</dt>
                    <dd class="col-sm-8">@(Model.Client?.Name ?? "N/A")</dd>

                    <dt class="col-sm-4">Tipo de Funcionário:</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Type)</dd>

                    <dt class="col-sm-4">Nome de Usuário:</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.User)</dd>
                </dl>
            </div>
        </div>

        <form asp-action="Delete" class="text-center">
            <input type="hidden" asp-for="ClientId" />
            <button type="submit" class="btn btn-danger btn-lg">
                <i class="fas fa-trash-alt"></i> Confirmar Exclusão
            </button>
            <a asp-action="List" class="btn btn-secondary btn-lg">
                <i class="fas fa-times"></i> Cancelar
            </a>
        </form>
    </div>
</body>
</html>
