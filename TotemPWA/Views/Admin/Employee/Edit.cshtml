@model TotemPWA.ViewModels.EmployeeViewModel

@{
    ViewData["Title"] = "Criar Funcionário";
}

<h1>Criar Funcionário</h1>

<h4>Funcionário</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Employee.ClientId" class="control-label"></label>
                <select asp-for="Employee.ClientId" class="form-control" asp-items="@Model.Clients">
                    <option value="">-- Selecione um Cliente --</option>
                </select>
                <span asp-validation-for="Employee.ClientId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Employee.Type" class="control-label"></label>
                <input asp-for="Employee.Type" class="form-control" />
                <span asp-validation-for="Employee.Type" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Employee.User" class="control-label"></label>
                <input asp-for="Employee.User" class="form-control" />
                <span asp-validation-for="Employee.User" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Employee.Password" class="control-label"></label>
                <input asp-for="Employee.Password" type="password" class="form-control" />
                <span asp-validation-for="Employee.Password" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <input type="submit" value="Criar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="List">Voltar para a Lista</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}