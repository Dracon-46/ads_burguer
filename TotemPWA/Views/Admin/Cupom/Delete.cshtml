@model TotemPWA.Models.Cupom

@{
    ViewData["Title"] = "Excluir Cupom";
}

<link rel="stylesheet" href="/css/excluirCrud.css" />

<div class="container">
    <h1>Excluir Cupom</h1>
    <h3>Tem certeza de que deseja excluir este cupom?</h3>
        <div class="product-details">
        <h4>Cupom</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Code)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Code)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Type)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Type)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Value)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Value)
            </dd>
        </dl>

        <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id">
            <input type="hidden" asp-for="Id" />
            <input type="submit" value="Excluir" class="btn btn-danger" /> |
            <a asp-action="List" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>    
</div>