@model IEnumerable<TotemPWA.Models.Cupom>

@{
    ViewData["Title"] = "Cupons";
}

<link rel="stylesheet" href="/css/lista.css" />
<script src="https://kit.fontawesome.com/ed744b56ed.js" crossorigin="anonymous"></script>

<div class="container-geral">
    <aside class="sidebar">
        <div class="logo">
            <img src="/images/logo_crud.png" alt="">
        </div>
        <nav class="menu">
            <h3>MENU</h3>
            <ul>
                <a asp-controller="Admin" asp-action="Index">
                    <li><i class="fa-solid fa-house"></i> Início</li>
                </a>
                <a asp-controller="Category" asp-action="List">
                    <li><i class="fa-solid fa-layer-group"></i> Categorias</li>
                </a>
                <a asp-controller="Product" asp-action="List">
                    <li><i class="fa-solid fa-box-open"></i> Produtos</li>
                </a>
                <a asp-controller="Product" asp-action="List">
                    <li><i class="fa-solid fa-carrot"></i> Ingredientes</li>
                </a>
                <a asp-controller="Cupom" asp-action="List">
                    <li><i class="fa-solid fa-ticket"></i> Cupons</li>
                </a>
                <a asp-controller="Promotion" asp-action="List">
                    <li><i class="fa-solid fa-tags"></i> Promoções</li>
                </a>
            </ul>
        </nav>
    </aside>

    <main class="conteudo-principal">
        <div style="display: flex; justify-content: space-between; align-items: center; padding: 20px;">
            <div>
                <h1>@ViewData["Title"]</h1>
                <p style="color: #666; margin: 0;">Gerencie os cupons de desconto da hamburgueria.</p>
            </div>
            <a asp-action="Create" class="btn-novo-produto">+ Novo Cupom</a>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger" role="alert">
                @TempData["ErrorMessage"]
            </div>
        }

        <div class="produtos-container">
            @foreach (var item in Model)
            {
                <div class="produto-card">
                    <div class="card-topo">
                        <h3>@item.Code</h3>
                        <span class="tag">@item.Type</span>
                    </div>
                    <p>Valor: 
                        @* --- CORREÇÃO: Exibe o valor de porcentagem corretamente --- *@
                        @if (item.Type.Equals("percentual", StringComparison.OrdinalIgnoreCase))
                        {
                            @($"{item.Value * 100M}%") 
                        }
                        else
                        {
                            @($"R$ {item.Value:N2}") 
                        }
                        @* --- FIM DA CORREÇÃO --- *@
                    </p>
                    <div class="status">
                        <span class="disponivel">✔ Ativo</span>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="excluir"><i class="fa-solid fa-trash"></i> Excluir</a>
                    </div>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn-editar">✏ Editar</a>
                </div>
            }
        </div>
    </main>
</div>