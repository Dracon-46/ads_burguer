@model TotemPWA.Models.Cupom

<div class="form-group">
    <label asp-for="Code" class="control-label">Código:</label>
    <input asp-for="Code" class="form-control" />
    <span asp-validation-for="Code" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="Type" class="control-label">Tipo:</label>
    <select asp-for="Type" class="form-control">
        <option value="fixo">Fixo</option>
        <option value="percentual">Porcentual</option>
    </select>
    <span asp-validation-for="Type" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="Value" class="control-label">Valor</label>
    <input asp-for="Value" class="form-control" type="number" step="0.01" /> <span asp-validation-for="Value" class="text-danger"></span>
</div>