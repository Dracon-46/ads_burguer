@model TotemPWA.Models.Promotion

@{
    ViewData["Title"] = "Excluir Promoção";
}

<link rel="stylesheet" href="/css/excluirCrud.css" />

<div class="container">
    <h1>Excluir Promoção</h1>

    <h3>Tem certeza de que deseja excluir esta promoção?</h3>
    <div class="promotion-details">
        <h4>Detalhes da Promoção</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Product)
            </dt>
            <dd class="col-sm-9">
                @(Model.Product?.Name ?? "Produto Desconhecido")
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Percent)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Percent)%
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.ValidUntil)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.ValidUntil)
            </dd>
        </dl>

        <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="submit" value="Excluir" class="btn btn-danger" /> |
            <a asp-action="List" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>     
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}