@model TotemPWA.Models.Promotion

@{
    ViewData["Title"] = "Excluir Promoção";
}

  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet"> 
<style>
    /* A importação da fonte Poppins já está no HTML fornecido */

    /* Estilos para o título principal da página */
    h1 {
        font-family: 'Poppins', sans-serif;
        text-align: center;
        color: #f66302; /* Cor do título */
        margin-top: 50px;
        margin-bottom: 20px;
        font-size: 2.5em;
        font-weight: 700;
    }

    /* Estilos para a pergunta de confirmação (h3, específico do Delete) */
    h3 {
        font-family: 'Poppins', sans-serif;
        text-align: center;
        color: #333333;
        margin-bottom: 30px;
        font-size: 1.4em;
        font-weight: 500;
    }

    /* Estilos para o contêiner principal da página (geralmente envolve todo o conteúdo principal da tela) */
    .container {
        max-width: 700px; /* Largura máxima para o contêiner de detalhes */
        margin: 0 auto 50px auto; /* Centraliza o contêiner e adiciona margem inferior */
        padding: 30px;
        background-color: #ffffff;
        border-radius: 10px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        box-sizing: border-box; /* Inclui padding na largura */
    }

    /* Estilos para o bloco de detalhes da promoção */
    /* Este é o elemento que envolve as informações da promoção (nome, descrição, preço, etc.) */
    .promotion-details { /* Renomeado de .product-details para .promotion-details para clareza */
        text-align: center; /* Centraliza o h4 e a hr dentro deste bloco */
        margin-bottom: 30px;
        padding: 20px;
        border: 1px solid #e0e0e0; /* Uma borda suave para o bloco de detalhes */
        border-radius: 8px;
        background-color: #fdfdfd; /* Fundo ligeiramente diferente para o bloco */
    }

    /* Estilos para o subtítulo "Detalhes da Promoção" dentro dos detalhes */
    .promotion-details h4 {
        font-family: 'Poppins', sans-serif;
        text-align: center; /* Centraliza o subtítulo "Promoção" */
        color: #555555;
        margin-bottom: 15px;
        font-size: 1.2em;
        font-weight: 600;
    }

    /* Estilos para a linha divisória dentro dos detalhes */
    .promotion-details hr {
        border: 0;
        height: 1px;
        background-image: linear-gradient(to right, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.1));
        margin-bottom: 20px;
        width: 80%; /* Ajusta a largura da linha para não ser 100% */
        margin-left: auto; /* Centraliza a linha */
        margin-right: auto; /* Centraliza a linha */
        max-width: none; /* Remove a limitação de largura se houver */
    }

    /* Estilos para a lista de descrição (dl, dt, dd) */
    dl.row {
        display: flex;
        flex-wrap: wrap;
        width: 100%; /* Ocupa a largura total do .promotion-details */
        max-width: 500px; /* Limita a largura da dl para manter o texto legível */
        margin: 0 auto; /* Centraliza o bloco dl DENTRO do promotion-details */
        font-family: 'Poppins', sans-serif;
        text-align: initial; /* Garante que o dl.row não force centralização de seu conteúdo */
    }

    dl.row dt,
    dl.row dd {
        margin-bottom: 10px;
    }

    .col-sm-3 { /* Estilo para os termos (labels) */
        flex-basis: 25%; /* 3 colunas de 12 */
        max-width: 25%;
        font-weight: 600; /* Negrito para os termos */
        color: #333333;
        padding-right: 15px; /* Espaçamento entre termo e descrição */
        text-align: right; /* Alinha o termo à direita */
    }

    .col-sm-9 { /* Estilo para as descrições (valores) */
        flex-basis: 75%; /* 9 colunas de 12 */
        max-width: 75%;
        color: #555555;
        text-align: left; /* Alinha a descrição à esquerda */
    }
    
    /* Estilos para o grupo de botões (form-actions) */
    .form-actions { /* Renomeado de .form-group.mt-3 para .form-actions, que é mais semanticamente correto para botões de ação */
        margin-top: 30px;
        display: flex;
        justify-content: center; /* Centraliza os botões */
        gap: 20px;
        width: 100%; /* Garante que os botões usem a largura total disponível */
        align-items: center; /* Alinha verticalmente os botões */
    }

    /* Estilos para os botões */
    .btn {
        width: 170px; /* Largura fixa para os botões */
        height: 48px; /* Altura fixa para os botões */
        border: none;
        border-radius: 6px;
        font-size: 1.1em;
        cursor: pointer;
        transition: background-color 0.3s ease; /* Apenas transição de cor */
        text-decoration: none;
        display: inline-flex; /* Usa inline-flex para os botões ficarem lado a lado */
        align-items: center; /* Centraliza verticalmente o texto */
        justify-content: center; /* Centraliza horizontalmente o texto */
        font-weight: 500;
        box-sizing: border-box; /* Inclui padding e borda na largura/altura */
        font-family: 'Poppins', sans-serif;
        padding: 0; 
        margin: 0; 
        line-height: 1; 
        vertical-align: middle; 
    }

    /* Estilo para o botão de exclusão (Perigo) */
    .btn-danger {
        background-color: #a50000; /* Cor do botão Excluir: #a50000 */
        color: #ffffff; /* Cor do texto branca para contraste */
    }

    .btn-danger:hover {
        background-color: #8c0000; /* Vermelho mais escuro ao passar o mouse */
    }

    /* Estilo para o botão secundário (Cancelar) */
    .btn-secondary {
        background-color: #f66302; /* Cor do botão Cancelar: #f66302 */
        color: #ffffff; /* Cor do texto branca para contraste */
    }

    .btn-secondary:hover {
        background-color: #e05c00; /* Laranja mais escuro ao passar o mouse */
    }
</style>
<div class="container">
    <h1>Excluir Promoção</h1>

    <h3>Tem certeza de que deseja excluir esta promoção?</h3>
    <div class="promotion-details">
        <h4>Detalhes da Promoção</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-3">
                Produto:
            </dt>
            <dd class="col-sm-9">
                @(Model.Product?.Name ?? "Produto Desconhecido")
            </dd>
            <dt class="col-sm-3">
                Porcentagem de Desconto:
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Percent)%
            </dd>
            <dt class="col-sm-3">
                Data de Validade:
            </dt>
            <dd class="col-sm-9">
               @Html.DisplayFor(model => model.ValidUntil)
            </dd>
        </dl>

        @* ESTA É A LINHA CORRIGIDA PARA O BOTÃO DE DELETAR FUNCIONAR: *@
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="submit" value="Excluir" class="btn btn-danger" /> 
            <a asp-action="List" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>    
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}