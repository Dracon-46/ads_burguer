@model IEnumerable<TotemPWA.Models.Promotion>

@{
    ViewData["Title"] = "Lista de Promoções";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Criar Nova Promoção</a>
</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Product)</th>
            <th>@Html.DisplayNameFor(model => model.Percent)</th>
            <th>@Html.DisplayNameFor(model => model.ValidUntil)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
              <td>
    @(item.Product?.Name ?? "Produto Não Encontrado")
</td>
                <td>@Html.DisplayFor(modelItem => item.Percent)%</td>
                <td>@Html.DisplayFor(modelItem => item.ValidUntil)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-info">Editar</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>