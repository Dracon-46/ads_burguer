@model TotemPWA.ViewModels.PromotionViewModel

@{
    ViewData["Title"] = "Criar Promoção";
}

<link rel="stylesheet" href="/css/form_crud.css" />

<h1>Criar Promoção</h1>

<h4>Promoção</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <partial name="_Form" model="Model" />
            <div class="form-group mt-3">
                <button type="submit" class="btn btn-primary">Salvar</button>
                <a asp-action="List" class="btn btn-secondary">Voltar para a Lista</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}