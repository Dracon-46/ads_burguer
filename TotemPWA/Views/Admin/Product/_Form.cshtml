@model TotemPWA.ViewModels.ProductViewModel

<div class="form-group">
    <label  class="control-label">Nome do Produto:</label>
    <input asp-for="Product.Name" class="form-control" />
    <span asp-validation-for="Product.Name" class="text-danger"></span>
</div>
<div class="form-group">
    <label  class="control-label">Descrição:</label>
    <textarea asp-for="Product.Description" class="form-control"></textarea>
    <span asp-validation-for="Product.Description" class="text-danger"></span>
</div>
<div class="form-group">
    <label class="control-label">Preço:</label>
    <input asp-for="Product.Price" class="form-control" />
    <span asp-validation-for="Product.Price" class="text-danger"></span>
</div>
<div class="form-group">
    <label class="control-label">Categoria:</label>
    <select asp-for="Product.CategoryId" class="form-control" asp-items="Model.Categories">
        <option value="">Categoria Principal</option>
    </select>
    <span asp-validation-for="Product.CategoryId" class="text-danger"></span>
</div>
<div class="form-group form-check">
    <input class="form-check-input" asp-for="Product.Active" />
    <label class="form-check-label" asp-for="Product.Active"></label>
</div>