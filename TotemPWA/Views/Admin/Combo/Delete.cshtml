@model TotemPWA.Models.ViewModels.ComboViewModel

@{
    ViewData["Title"] = "Excluir Combo";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
        <style>
    /* Base Styles */
    .combo-container {
        font-family: 'Roboto', sans-serif;
        max-width: 1200px;
        margin: 2rem auto;
        padding: 0 1rem;
    }

    .combo-card {
        border-radius: 0.5rem;
        overflow: hidden;
        border: none;
    }

    .combo-header {
        padding: 1.25rem 1.5rem;
        border-bottom: none;
    }

    .combo-body {
        padding: 2rem;
    }

    /* Form Elements */
    .combo-form .form-group {
        margin-bottom: 1.5rem;
    }

    .combo-label {
        font-weight: 500;
        color: #495057;
        margin-bottom: 0.5rem;
        display: block;
    }

    .combo-select, 
    .combo-multi-select,
    .combo-price-input {
        border: 1px solid #ced4da;
        border-radius: 0.375rem;
        padding: 0.5rem 0.75rem;
        transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
    }

    .combo-select:focus, 
    .combo-multi-select:focus,
    .combo-price-input:focus {
        border-color: #86b7fe;
        outline: 0;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
    }

    /* Select2 Customization */
    .select2-container--default .select2-selection--multiple,
    .select2-container--default .select2-selection--single {
        border: 1px solid #ced4da;
        border-radius: 0.375rem;
        min-height: 38px;
    }

    .select2-container--default .select2-selection--multiple {
        min-height: 100px;
    }

    .select2-container--default.select2-container--focus .select2-selection--multiple,
    .select2-container--default.select2-container--focus .select2-selection--single {
        border-color: #86b7fe;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
    }

    /* Validation Styles */
    .combo-validation-summary {
        padding: 1rem;
        margin-bottom: 1.5rem;
    }

    .combo-validation {
        font-size: 0.875rem;
        margin-top: 0.25rem;
    }

    /* Buttons */
    .combo-form-actions {
        display: flex;
        gap: 1rem;
        margin-top: 2rem;
    }

    .combo-create-btn,
    .combo-save-btn,
    .combo-delete-btn,
    .combo-back-btn,
    .combo-cancel-btn,
    .combo-action-btn {
        padding: 0.5rem 1.25rem;
        font-weight: 500;
        border-radius: 0.375rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .combo-create-btn { background-color: #198754; border-color: #198754; }
    .combo-save-btn { background-color: #ffc107; border-color: #ffc107; color: #212529; }
    .combo-delete-btn { background-color: #dc3545; border-color: #dc3545; }
    .combo-back-btn,
    .combo-cancel-btn { background-color: #6c757d; border-color: #6c757d; }
    .combo-action-btn { background-color: #0d6efd; border-color: #0d6efd; }

    /* Details Page Styles */
    .combo-confirm-message {
        margin-bottom: 1.5rem;
    }

    .combo-divider {
        margin: 1.5rem 0;
        border-top: 1px solid rgba(0, 0, 0, 0.1);
    }

    .combo-details-container {
        background-color: #f8f9fa;
        border-radius: 0.5rem;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .combo-detail-item {
        margin-bottom: 1rem;
    }

    .combo-detail-label {
        font-weight: 500;
        color: #495057;
        display: block;
        margin-bottom: 0.25rem;
    }

    .combo-detail-value {
        color: #212529;
        display: block;
        margin-left: 1.5rem;
    }

    .combo-products-list {
        margin-left: 1.5rem;
    }

    .product-item {
        display: block;
        padding: 0.25rem 0;
        color: #212529;
    }

    .combo-empty-warning {
        color: #6c757d;
        font-style: italic;
    }

    /* List Page Styles */
    .combo-page-title {
        color: #212529;
        font-weight: 600;
    }

    .combo-table-container {
        margin-top: 1.5rem;
        border-radius: 0.5rem;
        overflow: hidden;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }

    .combo-table {
        margin-bottom: 0;
    }

    .combo-table-header {
        background-color: #f8f9fa;
        color: #495057;
        font-weight: 600;
        padding: 1rem;
    }

    .combo-item td {
        padding: 1rem;
        vertical-align: top;
        border-top: 1px solid #dee2e6;
    }

    .combo-name {
        font-weight: 500;
        color: #212529;
    }

    .combo-price {
        font-weight: 500;
        color: #198754;
    }

    .combo-actions {
        white-space: nowrap;
    }

    .combo-actions .btn {
        width: 2.5rem;
        height: 2.5rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
    }

    .combo-empty-message {
        margin-top: 2rem;
        padding: 1.5rem;
    }

    .combo-create-link {
        color: #0d6efd;
        text-decoration: underline;
        font-weight: 500;
    }

    .combo-alert {
        margin-bottom: 1.5rem;
        border-radius: 0.5rem;
    }
</style>
    
    <div class="combo-container combo-delete-container"></div>
    <div class="card shadow-sm combo-card">
        <div class="card-header bg-danger text-white combo-header">
            <h4 class="mb-0">
                <i class="fas fa-trash-alt me-2"></i>@ViewData["Title"]
            </h4>
        </div>
        <div class="card-body combo-body">
            <h5 class="card-title text-danger combo-confirm-message">
                <i class="fas fa-exclamation-triangle me-2"></i>Tem certeza que deseja excluir este combo?
            </h5>
            <hr class="combo-divider" />
            
            <div class="combo-details-container">
                <div class="combo-detail-item">
                    <span class="combo-detail-label">
                        <i class="fas fa-tag me-2"></i>@Html.DisplayNameFor(model => model.ComboProductName):
                    </span>
                    <span class="combo-detail-value">@Html.DisplayFor(model => model.ComboProductName)</span>
                </div>
                
                @if (Model.IncludedProducts != null && Model.IncludedProducts.Any())
                {
                    <div class="combo-detail-item">
                        <span class="combo-detail-label">
                            <i class="fas fa-list-ol me-2"></i>Itens no Combo:
                        </span>
                        <div class="combo-products-list">
                            @foreach (var includedProduct in Model.IncludedProducts)
                            {
                                <div class="product-item">
                                    <i class="fas fa-utensils me-2"></i>@includedProduct.ProductName (R$ @includedProduct.ProductPrice.ToString("F2"))
                                </div>
                            }
                        </div>
                    </div>
                    
                    <div class="combo-detail-item">
                        <span class="combo-detail-label">
                            <i class="fas fa-dollar-sign me-2"></i>@Html.DisplayNameFor(model => model.ComboPrice):
                        </span>
                        <span class="combo-detail-value">R$ @Html.DisplayFor(model => model.ComboPrice)</span>
                    </div>
                }
                else
                {
                    <div class="combo-empty-warning">
                        <i class="fas fa-info-circle me-2"></i>Este combo não possui itens associados.
                    </div>
                }
            </div>

            <form asp-action="Delete" asp-route-id="@Model.ProductComboId" class="combo-form">
                <input type="hidden" asp-for="ProductComboId" />
                <div class="combo-form-actions mt-4">
                    <button type="submit" class="btn btn-danger combo-delete-btn">
                        <i class="fas fa-trash-alt me-2"></i>Confirmar Exclusão
                    </button>
                    <a asp-action="List" class="btn btn-secondary combo-cancel-btn">
                        <i class="fas fa-arrow-left me-2"></i>Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
</body>
</html>
