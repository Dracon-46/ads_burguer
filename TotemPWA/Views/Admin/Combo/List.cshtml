@model IEnumerable<TotemPWA.Models.ViewModels.ComboViewModel>

@{
    ViewData["Title"] = "Lista de Combos";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="~/css/Combo.css">
</head>
<body>
<div class="combo-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">@ViewData["Title"]</h2>
        <div>
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus"></i> Novo Combo
            </a>
            <a href="@Url.Action("Index", "Admin")" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Voltar
            </a>
        </div>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">
            @TempData["Message"]
        </div>
    }

    <div class="table-responsive">
        <table class="combo-table">
            <thead>
                <tr>
                    <th>Produto Principal</th>
                    <th>Itens no Combo</th>
                    <th>Preço</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.ComboProductName)</td>
                        <td>
                            @foreach (var includedProduct in item.IncludedProducts)
                            {
                                <div class="product-item">
                                    <i class="fas fa-utensils"></i> @includedProduct.ProductName (R$ @includedProduct.ProductPrice.ToString("F2"))
                                </div>
                            }
                        </td>
                        <td>R$ @Html.DisplayFor(modelItem => item.ComboPrice)</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.ProductComboId" class="btn btn-sm btn-warning" title="Editar">
                                <i class="fas fa-edit">Editar</i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.ProductComboId" class="btn btn-sm btn-danger" title="Excluir">
                                <i class="fas fa-trash-alt">Excluir</i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            <i class="fas fa-info-circle"></i> Nenhum combo cadastrado. <a asp-action="Create" class="alert-link">Crie um agora!</a>
        </div>
    }
</div>
</body>
</html>
