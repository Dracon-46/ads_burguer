@model TotemPWA.Models.ViewModels.ComboViewModel

@{
    ViewData["Title"] = "Criar Novo Combo";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
        <link rel="stylesheet" href="~/css/Combo.css" />

</head>
<body>
<div class="combo-container">
    <div class="combo-header">
        <h2><i class="fas fa-plus-circle"></i> @ViewData["Title"]</h2>
    </div>

    <div class="combo-form">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="ProductComboId" class="combo-label">
                            <i class="fas fa-tag"></i> Produto Principal
                        </label>
                        <select asp-for="ProductComboId" asp-items="@Model.AvailableProducts" class="form-control combo-select">
                            <option value="">-- Selecione o Produto --</option>
                        </select>
                        <span asp-validation-for="ProductComboId" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="ComboPrice" class="combo-label">
                            <i class="fas fa-dollar-sign"></i> Preço do Combo
                        </label>
                        <input asp-for="ComboPrice" class="form-control" />
                        <span asp-validation-for="ComboPrice" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="SelectedProductIds" class="combo-label">
                    <i class="fas fa-list-ol"></i> Itens do Combo
                </label>
                <select asp-for="SelectedProductIds" asp-items="@Model.AvailableProducts" class="form-control combo-multi-select" multiple>
                </select>
                <span asp-validation-for="SelectedProductIds" class="text-danger"></span>
            </div>

            <div class="form-group text-right">
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-save"></i> Criar Combo
                </button>
                <a asp-action="List" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Voltar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function() {
            $('.combo-select').select2({
                placeholder: "Selecione o produto principal",
                width: '100%'
            });
            
            $('.combo-multi-select').select2({
                placeholder: "Selecione os itens do combo",
                width: '100%'
            });
        });
    </script>
}
</body>
</html>
