@model TotemPWA.Models.ViewModels.ComboViewModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js"></script>
    <link rel="stylesheet" href="~/css/Combo.css" />
</head>
<body>
 @model TotemPWA.Models.ViewModels.ComboViewModel

<div class="form-group">
    <label asp-for="ProductComboId" class="combo-label">
        <i class="fas fa-tag"></i> Produto Principal
    </label>
    <select asp-for="ProductComboId" asp-items="@Model.AvailableProducts" class="form-control combo-select">
        <option value="">-- Selecione o Produto que será o Combo --</option>
    </select>
    <span asp-validation-for="ProductComboId" class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="SelectedProductIds" class="combo-label">
        <i class="fas fa-list-ol"></i> Produtos Incluídos
    </label>
    <select asp-for="SelectedProductIds" asp-items="@Model.AvailableProducts" class="form-control combo-multi-select" multiple="multiple">
    </select>
    <span asp-validation-for="SelectedProductIds" class="text-danger"></span>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function() {
            $('.combo-select').select2({
                placeholder: "Selecione o produto principal",
                width: '100%'
            });
            
            $('.combo-multi-select').select2({
                placeholder: "Selecione os produtos incluídos",
                width: '100%'
            });
        });
    </script>
}
</body>
</html>
