@model TotemPWA.Models.ViewModels.ComboViewModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js"></script>
</head>
<body>

        <style>
    /* Base Styles */
    .combo-container {
        font-family: 'Roboto', sans-serif;
        max-width: 1200px;
        margin: 2rem auto;
        padding: 0 1rem;
    }

    .combo-card {
        border-radius: 0.5rem;
        overflow: hidden;
        border: none;
    }

    .combo-header {
        padding: 1.25rem 1.5rem;
        border-bottom: none;
    }

    .combo-body {
        padding: 2rem;
    }

    /* Form Elements */
    .combo-form .form-group {
        margin-bottom: 1.5rem;
    }

    .combo-label {
        font-weight: 500;
        color: #495057;
        margin-bottom: 0.5rem;
        display: block;
    }

    .combo-select, 
    .combo-multi-select,
    .combo-price-input {
        border: 1px solid #ced4da;
        border-radius: 0.375rem;
        padding: 0.5rem 0.75rem;
        transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
    }

    .combo-select:focus, 
    .combo-multi-select:focus,
    .combo-price-input:focus {
        border-color: #86b7fe;
        outline: 0;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
    }

    /* Select2 Customization */
    .select2-container--default .select2-selection--multiple,
    .select2-container--default .select2-selection--single {
        border: 1px solid #ced4da;
        border-radius: 0.375rem;
        min-height: 38px;
    }

    .select2-container--default .select2-selection--multiple {
        min-height: 100px;
    }

    .select2-container--default.select2-container--focus .select2-selection--multiple,
    .select2-container--default.select2-container--focus .select2-selection--single {
        border-color: #86b7fe;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
    }

    /* Validation Styles */
    .combo-validation-summary {
        padding: 1rem;
        margin-bottom: 1.5rem;
    }

    .combo-validation {
        font-size: 0.875rem;
        margin-top: 0.25rem;
    }

    /* Buttons */
    .combo-form-actions {
        display: flex;
        gap: 1rem;
        margin-top: 2rem;
    }

    .combo-create-btn,
    .combo-save-btn,
    .combo-delete-btn,
    .combo-back-btn,
    .combo-cancel-btn,
    .combo-action-btn {
        padding: 0.5rem 1.25rem;
        font-weight: 500;
        border-radius: 0.375rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .combo-create-btn { background-color: #198754; border-color: #198754; }
    .combo-save-btn { background-color: #ffc107; border-color: #ffc107; color: #212529; }
    .combo-delete-btn { background-color: #dc3545; border-color: #dc3545; }
    .combo-back-btn,
    .combo-cancel-btn { background-color: #6c757d; border-color: #6c757d; }
    .combo-action-btn { background-color: #0d6efd; border-color: #0d6efd; }

    /* Details Page Styles */
    .combo-confirm-message {
        margin-bottom: 1.5rem;
    }

    .combo-divider {
        margin: 1.5rem 0;
        border-top: 1px solid rgba(0, 0, 0, 0.1);
    }

    .combo-details-container {
        background-color: #f8f9fa;
        border-radius: 0.5rem;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .combo-detail-item {
        margin-bottom: 1rem;
    }

    .combo-detail-label {
        font-weight: 500;
        color: #495057;
        display: block;
        margin-bottom: 0.25rem;
    }

    .combo-detail-value {
        color: #212529;
        display: block;
        margin-left: 1.5rem;
    }

    .combo-products-list {
        margin-left: 1.5rem;
    }

    .product-item {
        display: block;
        padding: 0.25rem 0;
        color: #212529;
    }

    .combo-empty-warning {
        color: #6c757d;
        font-style: italic;
    }

    /* List Page Styles */
    .combo-page-title {
        color: #212529;
        font-weight: 600;
    }

    .combo-table-container {
        margin-top: 1.5rem;
        border-radius: 0.5rem;
        overflow: hidden;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }

    .combo-table {
        margin-bottom: 0;
    }

    .combo-table-header {
        background-color: #f8f9fa;
        color: #495057;
        font-weight: 600;
        padding: 1rem;
    }

    .combo-item td {
        padding: 1rem;
        vertical-align: top;
        border-top: 1px solid #dee2e6;
    }

    .combo-name {
        font-weight: 500;
        color: #212529;
    }

    .combo-price {
        font-weight: 500;
        color: #198754;
    }

    .combo-actions {
        white-space: nowrap;
    }

    .combo-actions .btn {
        width: 2.5rem;
        height: 2.5rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
    }

    .combo-empty-message {
        margin-top: 2rem;
        padding: 1.5rem;
    }

    .combo-create-link {
        color: #0d6efd;
        text-decoration: underline;
        font-weight: 500;
    }

    .combo-alert {
        margin-bottom: 1.5rem;
        border-radius: 0.5rem;
    }
</style>
    

    <div class="form-group">
    <label asp-for="ProductComboId"></label>
    <select asp-for="ProductComboId" asp-items="@Model.AvailableProducts" class="form-control">
        <option value="">-- Selecione o Produto que será o Combo --</option>
    </select>
    <span asp-validation-for="ProductComboId" class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="SelectedProductIds"></label>
    <select asp-for="SelectedProductIds" asp-items="@Model.AvailableProducts" class="form-control" multiple="multiple" style="min-height: 200px;">
    </select>
    <span asp-validation-for="SelectedProductIds" class="text-danger"></span>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function() {
            // Inicializar o select2 para os dropdowns de seleção múltipla, se estiver usando
            // Se você não tiver Select2 configurado, pode remover esta parte.
            // Exemplo de como inicializar:
            // $('#SelectedProductIds').select2();
            // $('#ProductComboId').select2();
        });
    </script>
}
</body>
</html>
