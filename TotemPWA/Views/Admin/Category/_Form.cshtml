@model TotemPWA.ViewModels.CategoryViewModel

@* O sumário de validação e o hidden input para ID serão gerenciados pelas views principais (Create/Edit)
   ou pela lógica condicional dentro desta partial. *@

@* Campo oculto para o ID, essencial para o método POST Edit.
   Só é renderizado se o ID não for 0 (indicando um objeto existente, não uma nova criação). *@
@if (Model.Id != 0) 
{
    @* Corrigindo CS1963: Usando name/value em vez de asp-for para o ID oculto, se necessário aqui *@
    <input type="hidden" name="Id" value="@Model.Id" /> 
}

<div class="form-group">
    <label asp-for="Name" class="control-label">Nome da Categoria</label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="Description" class="control-label">Descrição da categoria:</label>
    <textarea asp-for="Description" class="form-control"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="ParentCategoryId" class="control-label">Tipo:</label>
    @* Corrigindo CS1963: Passamos Model.ParentCategoryOptions diretamente para asp-items *@
    <select asp-for="ParentCategoryId" class="form-control"
            asp-items="Model.ParentCategoryOptions"> 
    </select>
    <span asp-validation-for="ParentCategoryId" class="text-danger"></span>
</div>

@* Botões de submissão foram movidos para as views principais (Create.cshtml e Edit.cshtml) *@