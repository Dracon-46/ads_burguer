@model TotemPWA.ViewModels.CategoryViewModel

<div class="form-group">
    <label asp-for="Category.Name" class="control-label"></label>
    <input asp-for="Category.Name" class="form-control" />
    <span asp-validation-for="Category.Name" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="Category.ParentCategoryId" class="control-label">Categoria Pai</label>
    <select asp-for="Category.ParentCategoryId" class="form-control" asp-items="Model.Categories">
        <option value="">-- Selecione uma Categoria Pai --</option>
    </select>
    <span asp-validation-for="Category.ParentCategoryId" class="text-danger"></span>
</div>