@model TotemPWA.ViewModels.CategoryViewModel 

@{
    ViewData["Title"] = "Criar Nova Categoria";
}

<link rel="stylesheet" href="/css/site.css" />
<link rel="stylesheet" href="/css/form.css" />
<script src="https://kit.fontawesome.com/ed744b56ed.js" crossorigin="anonymous"></script>

<div class="form-container">
    <h2>Criar Nova Categoria</h2>
    <hr />
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        
        @* Inclui a partial view que contém os campos do formulário *@
        <partial name="_Form" model="Model" /> 

        <div class="form-group button-group">
            <button type="submit" class="btn btn-primary">Salvar</button>
            <a asp-action="List" class="btn btn-secondary">Voltar para a Lista</a>
        </div>
        
        @Html.AntiForgeryToken()
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}