@model IEnumerable<TotemPWA.Models.Category>

@{
    ViewData["Title"] = "Lista de Categorias";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Criar Nova Categoria</a>
</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Name)</th>
            <th>@Html.DisplayNameFor(model => model.Slug)</th>
            <th>@Html.DisplayNameFor(model => model.Icon)</th>
            <th>Categoria Pai</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                <td>@Html.DisplayFor(modelItem => item.Slug)</td>
                <td>@Html.DisplayFor(modelItem => item.Icon)</td>
                <td>
                    @if (item.ParentCategory != null)
                    {
                        @Html.DisplayFor(modelItem => item.ParentCategory.Name)
                    }
                    else
                    {
                        <span>Nenhuma</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-info">Editar</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Excluir</a>
                </td>
            </tr>
            @if (item.Subcategories != null && item.Subcategories.Any())
            {
                @foreach (var subcat in item.Subcategories)
                {
                    <tr>
                        <td class="ps-4">-- @Html.DisplayFor(modelItem => subcat.Name)</td>
                        <td>@Html.DisplayFor(modelItem => subcat.Slug)</td>
                        <td>@Html.DisplayFor(modelItem => subcat.Icon)</td>
                        <td>@Html.DisplayFor(modelItem => item.Name)</td> @* Exibe a categoria pai explicitamente *@
                        <td>
                            <a asp-action="Edit" asp-route-id="@subcat.Id" class="btn btn-sm btn-info">Editar</a> |
                            <a asp-action="Delete" asp-route-id="@subcat.Id" class="btn btn-sm btn-danger">Excluir</a>
                        </td>
                    </tr>
                }
            }
        }
    </tbody>
</table>