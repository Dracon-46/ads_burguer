@model TotemPWA.Models.Category

@{
    ViewData["Title"] = "Excluir Categoria";
}

<link rel="stylesheet" href="/css/site.css" />
<link rel="stylesheet" href="/css/form.css" />
<script src="https://kit.fontawesome.com/ed744b56ed.js" crossorigin="anonymous"></script>

<div class="form-container">
    <h2>Confirmação de Exclusão</h2>
    <hr />
    <h3>Tem certeza que deseja excluir esta categoria?</h3>

    @if (Model != null)
    {
        <p><strong>Nome:</strong> @Model.Name</p> 
        
        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <p><strong>Descrição:</strong> @Model.Description</p>
        }
        else
        {
            <p><strong>Descrição:</strong> N/A</p>
        }

        @* Corrigindo CS8602 e CS1963: Acessando diretamente ou verificando nulidade *@
        @if (Model.ParentCategory != null)
        {
            <p><strong>Subcategoria de:</strong> @Model.ParentCategory.Name</p>
        }
        else
        {
            <p><strong>Tipo:</strong> Categoria Principal</p>
        }

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            @* Corrigindo CS1963: Usando name/value em vez de asp-for para o ID oculto *@
            <input type="hidden" name="Id" value="@Model.Id" /> 
            <div class="form-group button-group">
                <button type="submit" class="btn btn-danger">Excluir</button>
                <a asp-action="List" class="btn btn-secondary">Cancelar</a>
            </div>
            @Html.AntiForgeryToken()
        </form>
    }
    else
    {
        <p class="text-danger">Erro: Nenhuma categoria selecionada para exclusão ou categoria não encontrada.</p>
        <a asp-action="List" class="btn btn-secondary">Voltar para a Lista de Categorias</a>
    }
</div>