@model TotemPWA.Models.Category

@{
    ViewData["Title"] = "Excluir Categoria";
}

<link rel="stylesheet" href="/css/excluirCrud.css" />

<div class="container">
    <h1>Excluir Categoria</h1>

    <h3>Tem certeza de que deseja excluir esta categoria?</h3>
    <div class="product-details">
        <h4>Categoria</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Name)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Name)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Slug)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Slug)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Icon)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Icon)
            </dd>
            <dt class="col-sm-3">
                Categoria Pai
            </dt>
        <dd class="col-sm-10">
        @(Model.ParentCategory?.Name ?? "Nenhuma")
    </dd>
        </dl>

        <form asp-action="ConfirmDelete" asp-route-id="@Model.Id">
            <input type="hidden" asp-for="Id" />
            <input type="submit" value="Excluir" class="btn btn-danger" /> |
            <a asp-action="List" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>