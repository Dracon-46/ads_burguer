@model TotemPWA.Models.Category

@{
    ViewData["Title"] = "Excluir Categoria";
}

<link rel="stylesheet" href="/css/excluirCrud.css" />
<script src="https://kit.fontawesome.com/ed744b56ed.js" crossorigin="anonymous"></script>

<div class="container">
    <h1>Excluir Categoria</h1>
    <h3>Tem certeza que deseja excluir esta categoria?</h3>

    <div class="product-details">
        <h4>Categoria</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-3">Nome</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Descrição</dt>
            <dd class="col-sm-9">
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    @Model.Description
                }
                else
                {
                    <span>N/A</span>
                }
            </dd>

            <dt class="col-sm-3">Tipo</dt>
            <dd class="col-sm-9">
                @if (Model.ParentCategory != null)
                {
                    <span>Subcategoria de: @Model.ParentCategory.Name</span>
                }
                else
                {
                    <span>Categoria Principal</span>
                }
            </dd>
        </dl>

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <input type="hidden" name="Id" value="@Model.Id" />
            @Html.AntiForgeryToken()
            <div class="form-actions">
                <input type="submit" value="Excluir" class="btn btn-danger" />
                <a asp-action="List" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
