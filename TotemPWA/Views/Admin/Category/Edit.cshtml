@model TotemPWA.ViewModels.CategoryViewModel

@{
    ViewData["Title"] = "Editar Categoria";
}

<link rel="stylesheet" href="/css/form_crud.css">
<script src="https://kit.fontawesome.com/ed744b56ed.js" crossorigin="anonymous"></script>

<h1>Editar Categoria</h1>

<h4>Categoria</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="Id" />
            <partial name="_Form" model="Model" />

            <div class="form-group mt-3">
                <button type="submit" class="btn btn-success">Salvar Alterações</button>
                <a asp-action="List" class="btn btn-secondary">Cancelar</a>
            </div>

            @Html.AntiForgeryToken()
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
