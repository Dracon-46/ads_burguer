@{
    ViewData["Title"] = "Selecionar Forma de Pagamento";
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ADS Burguer</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <link rel="stylesheet" href="/css/selecionarpagamento.css" />
</head>
<body>
    <div class="container">
        <div class="header-container">
            <span class="titulo">Formas de Pagamento</span>
            <span class="subtitulo">Como deseja pagar?</span>
        </div>

        <div id="erro-pagamento" class="payment-alert-burguer" style="display:none;"></div>

        <div class="selecao-pagamento">
            <button class="btn-pagamento" onclick="validarPagamento('@Url.Action("TelaPagamentoCartao", "Payment")')">
                <div>
                    <p class="tp-pagamento">Cartão</p>
                    <p class="subinfo">Crédito, débito ou refeição</p>
                </div>
                <i class="fas fa-credit-card"></i>
            </button>

            <button class="btn-pagamento" onclick="validarPagamento('@Url.Action("TelaPagamentoCartDigital", "Payment")')">
                <div>
                    <p class="tp-pagamento">Cartão Digital</p>
                    <p class="subinfo">Apple Pay e Google Pay</p>
                </div>
                <i class="fas fa-wallet"></i>
            </button>

            <button class="btn-pagamento" onclick="validarPagamento('@Url.Action("TelaPagamentoPix", "Payment")')">
                <div>
                    <p class="tp-pagamento">Pix</p>
                    <p class="subinfo">Pagamento instantâneo</p>
                </div>
                <i class="fas fa-qrcode"></i>
            </button>

            <button class="btn-pagamento" onclick="validarPagamento('@Url.Action("TelaPagamentoDinheiro", "Payment")')">
                <div>
                    <p class="tp-pagamento">Dinheiro</p>
                    <p class="subinfo">Termine o pagamento no caixa</p>
                </div>
                <i class="fas fa-dollar-sign"></i>
            </button>
        </div>

        <div class="resumo-pedido">
            <div class="totais">
                <p>Total de itens: <strong id="totalItens">0</strong></p>
                <p>Total do pedido: <strong id="valorTotalPedido">R$ 0,00</strong></p>
            </div>
            <div class="botoes">
                <a href="@Url.Action("Cupom", "Home")">
                    <button class="cancelar">Voltar</button>
                </a>
            </div>
        </div>
    </div>

    <script>
        function validarPagamento(destino) {
            const carrinho = JSON.parse(localStorage.getItem("carrinho")) || [];
            const dadosCupom = JSON.parse(localStorage.getItem("dadosCupom")) || {};
            const valorTotalFinal = (typeof dadosCupom.valorFinalComDesconto === 'number' && dadosCupom.valorFinalComDesconto >= 0)
                ? dadosCupom.valorFinalComDesconto
                : (parseFloat(localStorage.getItem("valorTotal")) || 0);

            const divErro = document.getElementById("erro-pagamento");
            divErro.style.display = "none";
            divErro.innerText = "";

            if (carrinho.length === 0) {
                mostrarErro("Seu carrinho está vazio. Adicione itens antes de continuar.");
                return;
            }

            if (valorTotalFinal <= 0) {
                mostrarErro("O valor total do pedido não pode ser zero.");
                return;
            }

            // Redireciona para a tela de pagamento
            window.location.href = destino;
        }

        function mostrarErro(msg) {
            const divErro = document.getElementById("erro-pagamento");
            divErro.innerText = msg;
            divErro.style.display = "block";
        }

        document.addEventListener("DOMContentLoaded", function () {
            const carrinho = JSON.parse(localStorage.getItem("carrinho")) || [];
            const dadosCupom = JSON.parse(localStorage.getItem("dadosCupom")) || {};
            const valorTotalOriginal = parseFloat(localStorage.getItem("valorTotal")) || 0;

            const valorTotalParaExibir = (typeof dadosCupom.valorFinalComDesconto === 'number' && dadosCupom.valorFinalComDesconto >= 0)
                ? dadosCupom.valorFinalComDesconto
                : valorTotalOriginal;

            const totalItens = carrinho.reduce((acc, item) => acc + item.quantidade, 0);

            document.getElementById("totalItens").textContent = totalItens;
            document.getElementById("valorTotalPedido").textContent = valorTotalParaExibir.toLocaleString('pt-BR', {
                style: 'currency',
                currency: 'BRL'
            });
        });
    </script>
</body>
</html>
