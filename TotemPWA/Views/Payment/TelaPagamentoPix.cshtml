@using TotemPWA.Controllers
@using System.Globalization
@model TotemPWA.Controllers.PagamentoViewModel

@{
    ViewData["Title"] = "Pagamento - Pix";
    var erro = TempData["Erro"] as string;
    var sucesso = TempData["Sucesso"] as string;
}

<link rel="stylesheet" href="~/css/pagamento-burguer.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">

<div class="payment-fullscreen">
    <div class="payment-header-burguer"></div>

    <div class="payment-content">
        <div class="payment-method">
            <div>
                <h1>Burguer</h1>
                <h2>Pagamento com Pix</h2>
                <i class="fas fa-qrcode payment-icon-burguer"></i>
                <p>Pagamento instantâneo</p>
            </div>

            <div class="resumo-pagamento" style="background: #f8f9fa; padding: 15px; border-radius: 8px; margin: 20px 0;">
                <h3>Resumo do Pedido</h3>
                <div class="totais-pagamento">
                    <p>Total de itens: <strong>@Model.TotalItens</strong></p>

                    @if (Model.CupomData != null && Model.CupomData.IsValid)
                    {
                        <div id="cupom-info" style="border-top: 1px solid #ddd; padding-top: 10px; margin-top: 10px;">
                            <p>Cupom aplicado: <strong>@Model.CupomData.Codigo</strong></p>
                            <p>Desconto: 
                                <strong style="color: #28a745;">
                                    @(Model.CupomData.ValorParaExibicao ?? Model.CupomData.Desconto.ToString("C2", new CultureInfo("pt-BR")))
                                </strong>
                            </p>
                            <p>Subtotal: 
                                <strong>@Model.Subtotal.ToString("C2", new CultureInfo("pt-BR"))</strong>
                            </p>
                        </div>
                    }

                    <p style="font-size: 1.2em; font-weight: bold; color: #007bff;">
                        Total a pagar: <strong>@Model.TotalFinal.ToString("C2", new CultureInfo("pt-BR"))</strong>
                    </p>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(erro))
            {
                <div class="payment-alert-burguer alert-danger">@erro</div>
            }

            @if (!string.IsNullOrEmpty(sucesso))
            {
                <div class="payment-alert-burguer alert-success">@sucesso</div>
            }

            <form method="post" asp-action="ValidarPagamento" class="payment-form-burguer">
                <input type="hidden" name="metodo" value="Pix" />
                <input type="hidden" name="cupomCodigo" value="@Model.CupomData?.Codigo" />
                <input type="hidden" name="cupomDesconto" value="@Model.CupomData?.Desconto" />
                <input type="hidden" name="cupomTipoDesconto" value="@Model.CupomData?.TipoDesconto" />
                <input type="hidden" name="subtotal" value="@Model.Subtotal" />
                <input type="hidden" name="valorTotal" value="@Model.TotalFinal" />

                <button type="submit" class="btn-burguer btn-confirm-burguer">
                    <i class="fas fa-check-circle"></i> Confirmar Pagamento
                </button>
            </form>

            <div class="payment-buttons">
                <a asp-action="SelecionarPagamento" class="btn-burguer btn-secondary-burguer">
                    <i class="fas fa-arrow-left"></i> Voltar
                </a>
                <a asp-action="SelecionarPagamento" class="btn-burguer btn-cancel-burguer">
                    <i class="fas fa-times-circle"></i> Cancelar
                </a>
            </div>
        </div>
    </div>
</div>
