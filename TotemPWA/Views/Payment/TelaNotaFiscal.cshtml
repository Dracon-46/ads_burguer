@using TotemPWA.Models.ViewModels
@model TotemPWA.Models.ViewModels.NotaFiscalViewModel 
@{
    ViewData["Title"] = "Nota Fiscal";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <title>Nota Fiscal</title>
    <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
    <div class="nota-container">
        <div class="nota-header">
            Nota Fiscal
        </div>

        <div class="nota-body">
            <div class="info">
                <div><strong>Nome: </strong> @Model?.NomeComprador</div>
                <div><strong>CPF: </strong> @Model?.CPFComprador</div>
                <div><strong>Método de Pagamento: </strong> @Model?.MetodoPagamento</div>
                <div><strong>Transação: </strong> @Model?.NumeroTransacao</div>
                <div><strong>Data: </strong> @Model?.DataPagamento.ToString("dd/MM/yyyy HH:mm")</div>
            </div>

            <div class="produtos">
                <strong>Produtos comprados: </strong>
                <ul>
                    @if (Model?.Produtos != null)
                    {
                        @foreach (var item in Model.Produtos)
                        {
                            <li>@item.Quantity x @item.Name (@item.Price.ToString("C2"))</li>
                        }
                    }
                    else
                    {
                        <li>Nenhum produto listado.</li>
                    }
                </ul>
            </div>
        </div>

        <div class="nota-footer">
            <div class="totais">
                <div>Subtotal: @Model?.Subtotal.ToString("C2", new System.Globalization.CultureInfo("pt-BR"))</div>
                <div>Desconto aplicado: @Model?.DescontoAplicado.ToString("C2", new System.Globalization.CultureInfo("pt-BR"))</div>
                <div>Total Final: @Model?.TotalFinal.ToString("C2", new System.Globalization.CultureInfo("pt-BR"))</div>
            </div>
            <div class="voltar">
                <a href="@Url.Action("TelaFinal", "Home")" class="btn-voltar">Finalizar</a>
            </div>
        </div>
        
    </div>
</body>
</html>