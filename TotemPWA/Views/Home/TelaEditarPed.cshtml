<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ads Burger</title>
    <link rel="stylesheet" href="/css/persopedido.css">
    <script src="https://kit.fontawesome.com/ed744b56ed.js" crossorigin="anonymous"></script>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>

<body>
    <div class="container">
        <h1>Personalizar Ingredientes</h1>

        <div id="ingredientes-lista">
            <div class="ingrediente" data-preco="3">
                <img src="/images/alface.png" alt="Alface">
                <div class="info">
                    <p>Adicionar: Alface</p>
                    <p>R$ 3,00</p>
                </div>
                <div class="controles">
                    <button class="decrementar">-</button>
                    <span class="quantidade">0</span>
                    <button class="incrementar">+</button>
                </div>
            </div>
    
            <div class="ingrediente" data-preco="3">
                <img src="/images/tomate.png" alt="Tomate">
                <div class="info">
                    <p>Adicionar: Tomate</p>
                    <p>R$ 3,00</p>
                </div>
                <div class="controles">
                    <button class="decrementar">-</button>
                    <span class="quantidade">0</span>
                    <button class="incrementar">+</button>
                </div>
            </div>
    
            <div class="ingrediente" data-preco="3">
                <img src="/images/queijo.png" alt="Queijo">
                <div class="info">
                    <p>Adicionar: Queijo</p>
                    <p>R$ 3,00</p>
                </div>
                <div class="controles">
                    <button class="decrementar">-</button>
                    <span class="quantidade">0</span>
                    <button class="incrementar">+</button>
                </div>
            </div>
            <div class="ingrediente" data-preco="3">
                <img src="/images/cebola.png" alt="Cebola">
                <div class="info">
                    <p>Adicionar: Cebola</p>
                    <p>R$ 3,00</p>
                </div>
                <div class="controles">
                    <button class="decrementar">-</button>
                    <span class="quantidade">0</span>
                    <button class="incrementar">+</button>
                </div>
            </div>
            <div class="ingrediente" data-preco="3">
                <img src="/images/maionese.png" alt="Maionese">
                <div class="info">
                    <p>Adicionar: Maionese</p>
                    <p>R$ 3,00</p>
                </div>
                <div class="controles">
                    <button class="decrementar">-</button>
                    <span class="quantidade">0</span>
                    <button class="incrementar">+</button>
                </div>
            </div>
            <div class="ingrediente" data-preco="3">
                <img src="/images/maionese_especial.png" alt="Molho Especial">
                <div class="info">
                    <p>Adicionar: Molho especial</p>
                    <p>R$ 3,00</p>
                </div>
                <div class="controles">
                    <button class="decrementar">-</button>
                    <span class="quantidade">0</span>
                    <button class="incrementar">+</button>
                </div>
            </div>
        </div>

        <div class="carrinho">
            <div class="car-left">
                <span class="total-itens">Total de itens: 0</span>
                <span class="total-pedidos">Total do Pedido: R$ 0</span>
            </div>
            <div class="car-right">
                <a href="./TelaPersoCombo"><button class="cancelar">Cancelar</button></a>
                <button class="confirmar">Confirmar</button>        
            </div>
        </div>
    </div>
    </div>

    <script src="/js/script.js"></script>
</body>

</html>