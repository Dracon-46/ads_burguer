<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Carrinho de Compras</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="/css/telacarrinho.css">
    <script defer src="/js/telacarrinho.js"></script>
</head>
<body>
    <header>
        <a href="@Url.Action("TelaProduto", "Home")" class="back-button">&#8592;</a>
        <button class="coupon-button">INSIRA AQUI SEU CUPOM!</button>
    </header>
    <main>
        <section class="category">
            <h2>LANCHES</h2>
            <div class="item">
                <img src="burger.png" alt="Buguer 404">
                <div class="details">
                    <h3>Buguer 404</h3>
                    <p>Pão brioche, queijo cheddar...</p>
                    <span class="price">R$ 49,80</span>
                    <div class="quantity">
                        <button>-</button>
                        <span>2</span>
                        <button>+</button>
                    </div>
                </div>
            </div>
            <div class="item">
                <img src="burger2.png" alt="Looping Duplo">
                <div class="details">
                    <h3>Looping Duplo</h3>
                    <p>Pão brioche, dois hambúrgueres...</p>
                    <span class="price">R$ 32,80</span>
                    <div class="quantity">
                        <button>-</button>
                        <span>1</span>
                        <button>+</button>
                    </div>
                </div>
            </div>
        </section>
        <section class="category">
            <h2>SOBREMESAS</h2>
            <div class="item">
                <img src="milkshake.png" alt="Milkshake Overflow Shake">
                <div class="details">
                    <h3>Milkshake "Overflow Shake"</h3>
                    <p>Milkshake de baunilha, calda de chocolate...</p>
                    <span class="price">R$ 17,90</span>
                    <div class="quantity">
                        <button>-</button>
                        <span>1</span>
                        <button>+</button>
                    </div>
                </div>
            </div>
        </section>
    </main>
    <footer>
        <div class="summary">
            <p>Total de itens: <span id="total-items">5</span></p>
            <p>Total do pedido: <span id="total-price">R$ 173,30</span></p>
        </div>
        <button class="cancel-button">Cancelar pedido</button>
        <button class="confirm-button">Confirmar pedido</button>
    </footer>
</body>
</html>
