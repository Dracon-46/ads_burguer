@model List<TotemPWA.Models.ViewModels.CartItemViewModel>

<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ADS - Burguer</title>
  <link rel="stylesheet" href="/css/telaproduto.css">
  <link rel="stylesheet" href="/css/telacarrinho.css">
  <link rel="stylesheet" href="/css/persopedido.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    /* Configuração de exibição das seções */
    #secaoPromocao { display: flex; }
    #secaoCombo,
    #secaoBebidas,
    #secaoLanches,
    #secaoSobremesa,
    #secaoUnitarios { display: none; }
  </style>
</head>
<body>
  <div class="container">
    
    <div class="banner"></div> <!-- Banner -->

    <div class="content">
      <div class="left"> <!-- Menu Lateral -->
        <div class="selection">
          @foreach (var category in ViewBag.Categories)
          {
            string activeClass = category.active ? "active" : "";
          
            <button class="link-button @activeClass" onclick="location.href='/TelaProduto/@category.slug'">
                <span>@category.name</span>
            </button>
          }
        </div>
      </div>

      
      <div class="right"> <!-- Seção Principal -->
        <div class="filtro">
          @foreach (var subcategory in ViewBag.SubCategories)
          {
              string activeClass = subcategory.active ? "active" : "";
              <button class="@activeClass" onclick="location.href='/TelaProduto/@ViewBag.CategorySlug/@subcategory.slug'">
                  @subcategory.name
              </button>
          }
        </div>

        <div class="produto-lista">
          @foreach (var product in ViewBag.Products)
          {
            
            <div class="btn-produto">
              
              <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRlk0v2LMXzPI2uVcV3KDSVqXWy55_5NeNKCQ&s" alt="@product.name">
              <span class="nome">@product.name</span>
              <span class="valor">@product.price.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</span>
              <p class="descricao">Descrição do produto</p>
              <form asp-controller="Cart" asp-action="AddItem" method="post">
                <input type="hidden" name="productId" value="@product.id" />
              </form>
              
            </div>
            
          }
        </div>
      </div>
    </div>

    <!-- Rodapé / Carrinho -->
    <div class="carrinho">
        <div class="car-left">
            <div>
                <span class="total-itens">Total de itens: 
                    <span id="footer-total-items">@(Model?.Sum(item => item.Quantity) ?? 0)</span>
                </span>
                <span class="total-pedidos">Total do Pedido: 
                    <span id="footer-total-price" style="color: #426b1f;">R$ @((Model?.Sum(item => item.Price * item.Quantity) ?? 0).ToString("F2"))</span>
                </span>
            </div>
        </div>
        
        <div class="car-center">
            <span class="view">VER CARRINHO</span>
            <a href="@Url.Action("Index", "Cart")" class="btn-car"><i class="fa-solid fa-cart-shopping"></i></a>
        </div>
        
        <div class="car-right">
            <div>
                <a href="@Url.Action("Cupom", "Home")" class="btn">Próximo</a>
            </div>

            <div>
                <a href="/" class="btn">Voltar ao Início</a>
            </div>
        </div>
    </div>
  </div>

  <!-- Scripts (remova o telacarrinho.js) -->
  <script src="/js/telaproduto.js"></script>
  <script src="/js/personalizar.js"></script>
</body>
</html>