<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ADS - Burguer</title>
  <link rel="stylesheet" href="/css/telaproduto.css">
  <link rel="stylesheet" href="/css/telacarrinho.css">
  <link rel="stylesheet" href="/css/persopedido.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    /* Configuração de exibição das seções */
    #secaoPromocao { display: block; }
    #secaoCombo,
    #secaoBebidas,
    #secaoLanches,
    #secaoSobremesa,
    #secaoUnitarios { display: none; }
  </style>
</head>
<body>
  <div class="container">
    <!-- Banner -->
    <div class="banner"></div>

    <div class="content">
      <!-- Menu Lateral -->
      <div class="left">
        <div class="selection">
          @foreach (var category in ViewBag.Categories)
          {
              string activeClass = category.active ? "active" : "";
              <button class="link-button @activeClass" onclick="location.href='/teste/@category.id'">
                  <div class="icon">
                      <img src="@category.icon" />
                  </div>
                  <span>@category.name</span>
              </button>
          }
        </div>
      </div>

      <!-- Seção Principal -->
      <div class="right">
        <div class="filtro">
          @foreach (var subcategory in ViewBag.SubCategories)
          {
              string activeClass = subcategory.active ? "active" : "";
              <button class="@activeClass" onclick="location.href='/teste/@ViewBag.Category/@subcategory.id'">
                  @subcategory.name
              </button>
          }
        </div>

        <div class="produto-lista">
          @foreach (var product in ViewBag.Products)
          {
              <div class="produto">
                  <button class="btn-produto" data-nome="@product.name" data-preco="@product.price" data-imagem="https://fakeimg.pl/60x60/?retina=1&text=%F0%9F%8D%95">
                      <img src="https://fakeimg.pl/60x60/?retina=1&text=%F0%9F%8D%95" alt="@product.name">
                      <span class="nome">@product.name</span>
                      <span class="valor">@product.price.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</span>
                      <p class="descricao">Descrição do produto</p>
                  </button>
              </div>
          }
        </div>
      </div>
    </div>

<!-- Rodapé / Carrinho -->
<div class="carrinho">
  <div class="car-left">
    <span class="total-itens">Total de itens: 
      <span id="footer-total-items">0</span>
    </span>
    <span class="total-pedidos">Total do Pedido: 
      <span id="footer-total-price" style="color: #426b1f;">R$ 0,00</span>
    </span>
  </div>
  
  <div class="car-center">
    <span class="view">VER CARRINHO</span>
    <a href="#" class="btn-car"><i class="fa-solid fa-cart-shopping"></i></a>
  </div>
  
  <div class="car-right">
    <a href="/" class="btn-cancel">Voltar ao Início</a>
    <!-- Opção 1 -->
    <a href="@Url.Action('Cupom', 'Home')" class="btn-pro">Próximo</a>
    <!-- Opção 2 -->
    <!-- <a href="TelaCPF" class="btn-pro">Próximo</a> -->
  </div>
</div>

<!-- Modal do Carrinho -->
<div id="cart-modal" class="cart-modal">
  <div class="cart-content">
    <div class="cart-header">
      <h2>Seu Carrinho</h2>
      <span class="close-cart">&times;</span>
    </div>
    
    <div class="cart-items">
      <!-- Itens serão adicionados dinamicamente aqui -->
    </div>
    
    <div class="cart-summary">
      <p>Total de itens: <span id="modal-total-items">0</span></p>
      <p>Total do pedido: <span id="modal-total-price">R$ 0,00</span></p>
    </div>
    
    <div class="cart-actions">
      <button class="cancel-button">Fechar</button>
      <button class="confirm-button">Confirmar Pedido</button>
    </div>
  </div>
</div>

  <!-- Scripts -->
  <script src="/js/telacarrinho.js"></script>
  <script src="/js/telaproduto.js"></script>
  <script src="/js/personalizar.js"></script>
</body>
</html>