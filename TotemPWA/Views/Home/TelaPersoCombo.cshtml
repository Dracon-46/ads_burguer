<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ads Burger</title>
    <link rel="stylesheet" href="/css/persocombo.css">
    <script src="https://kit.fontawesome.com/ed744b56ed.js" crossorigin="anonymous"></script>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>

<body>
    <div class="container">
        <div class="banner"></div>

        <div class="div-btn-back">
            <button class="btn-back"><i class="fas fa-arrow-left"></i></button>
        </div>
        
        <div class="combo-card">
            <img src="/images/Lanche-chicken.png" alt="Chicken Junior" class="combo-img">
            <div class="combo-info">
                <h2>Chicken Junior <a href="TelaEditarPed" class="icon-editar"><i class="fas fa-edit"></i></a></h2>
                <p>Filé de frango empanado, alface, tomate e maionese.</p>
            </div>
        </div>
        
        <div class="options">
            <div class="option">
                <h3>Escolha sua bebida</h3>
                <p>Selecione a bebida de sua preferência.</p>
            </div>
            
            <div class="option">
                <h3>Escolha o tamanho da batata</h3>
                <p>Escolha o tamanho da batata para acompanhar o seu combo.</p>
            </div>
        </div>

        <div class="carrinho">
            <div class="car-left">
                <span class="total-itens">Total de itens: 0</span>
                <span class="total-pedidos">Total do Pedido:  <span style="color: #426b1f;">R$ 0</span></span>
            </div>                
            <div class="car-center">
                <span class="view">VER CARRINHO</span>
                <button class="btn-car"><i class="fa-solid fa-cart-shopping"></i></button>
            </div>
            <div class="car-right">
                <button class="btn-pro">Próximo</button>
            </div>
        </div>
    </div>
    </div>

</body>

</html>