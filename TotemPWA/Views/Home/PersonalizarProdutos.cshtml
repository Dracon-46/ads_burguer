@model TotemPWA.ViewModels.PersonalizarProdutoViewModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Personalizar Produto</title>
    <link rel="stylesheet" href="/css/personalizarProduto.css">
</head>
<body>

<div class="container">
    <button class="back-btn" onclick="history.back()">← Voltar</button>

    <div class="card">
        <div class="item-header">
            <img src="@(Model.Produto.Image ?? Model.Produto.ImageUrl ?? "/images/products/default_product.png")" alt="Produto" class="burger-img" />
            <div class="item-info">
                <h3>@Model.Produto.Name</h3>
                <p>@Model.Produto.Description</p>
                <p class="price">Preço base: R$ <span id="precoBase">@Model.Produto.Price.ToString("F2")</span></p>
            </div>
        </div>
    </div>

    <form asp-controller="Customer" asp-action="SalvarPersonalizacao" method="post" id="personalizacaoForm">
        <input type="hidden" name="CartItemId" value="@Model.CartItemId" />
        <input type="hidden" name="ProdutoId" value="@Model.Produto.Id" />

        @if (Model.ProdutoAdditionals != null && Model.ProdutoAdditionals.Any())
        {
            <div class="card">
                <h4>Ingredientes</h4>
                <div class="size-options">
                    @foreach (var additional in Model.ProdutoAdditionals.OrderBy(a => a.Ingredient?.Name))
                    {
                        var ing = additional.Ingredient;
                        if (ing != null)
                        {
                            var productStandardQuantity = additional.Quantity; 

                            int currentQuantity;
                            if (Model.QuantidadesManipuladas.TryGetValue(ing.Id, out int manipulatedQuantity))
                            {
                                currentQuantity = manipulatedQuantity;
                            }
                            else
                            {
                                currentQuantity = productStandardQuantity; 
                            }

                            <div class="size-option"
                                data-ingredient-id="@ing.Id"
                                data-ing-price="@ing.Price.ToString("F2").Replace(",", ".")"
                                data-ing-limit="@ing.Limit"
                                data-product-standard-quantity="@productStandardQuantity">

                                <span>@ing.Name</span>
                                <p>R$ @ing.Price.ToString("F2")</p>
                                
                                <div class="quantity-control">
                                    <button type="button" class="btn-quantidade-sub">-</button>
                                    <span class="quantidade-ingrediente">@currentQuantity</span>
                                    <button type="button" class="btn-quantidade-add">+</button>

                                    <input type="hidden" class="ingrediente-hidden" name="IngredientesManipuladosQuantidades[@ing.Id]" value="@currentQuantity" />
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        }

        <div class="card">
            <h4>Preço Estimado:</h4>
            <p id="precoTotal">R$ @Model.Produto.Price.ToString("F2")</p>
        </div>

        <div class="footer">
            <button type="button" class="cancel-btn" onclick="history.back()">Cancelar</button>
            <button type="submit" class="add-btn">Confirmar</button>
        </div>
    </form>
</div>
<script>
    let initialBasePrice = parseFloat(document.getElementById("precoBase").innerText.replace(",", "."));

    function atualizarPrecoTotal() {
        let currentCalculatedPrice = initialBasePrice;

        document.querySelectorAll('.size-option').forEach(function (div) {
            const ingredientId = parseInt(div.getAttribute('data-ingredient-id'));
            const precoUnitarioIngrediente = parseFloat(div.getAttribute('data-ing-price'));
            const quantidadeAtualNoUI = parseInt(div.querySelector('.quantidade-ingrediente').innerText);
            const productStandardQuantity = parseInt(div.getAttribute('data-product-standard-quantity'));

            if (quantidadeAtualNoUI > productStandardQuantity) {
                currentCalculatedPrice += precoUnitarioIngrediente * (quantidadeAtualNoUI - productStandardQuantity);
            }
        });

        document.getElementById("precoTotal").innerText = "R$ " + currentCalculatedPrice.toFixed(2).replace(".", ",");
    }

    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.btn-quantidade-add').forEach(button => {
            button.addEventListener('click', function () {
                const sizeOptionDiv = this.closest('.size-option');
                const quantidadeSpan = sizeOptionDiv.querySelector('.quantidade-ingrediente');
                let quantidade = parseInt(quantidadeSpan.innerText);
                const ingredientId = parseInt(sizeOptionDiv.getAttribute('data-ingredient-id'));
                const limit = parseInt(sizeOptionDiv.getAttribute('data-ing-limit'));

                if (quantidade < limit) {
                    quantidade++;
                    quantidadeSpan.innerText = quantidade;

                    let hiddenInput = sizeOptionDiv.querySelector(`.ingrediente-hidden[name='IngredientesManipuladosQuantidades[${ingredientId}]']`);
                    if (!hiddenInput) {
                        hiddenInput = document.createElement('input');
                        hiddenInput.type = 'hidden';
                        hiddenInput.classList.add('ingrediente-hidden');
                        hiddenInput.name = `IngredientesManipuladasQuantidades[${ingredientId}]`;
                        sizeOptionDiv.appendChild(hiddenInput);
                    }
                    hiddenInput.value = quantidade.toString();

                    atualizarPrecoTotal();
                } else {
                    alert(`Limite de ${limit} unidades para ${sizeOptionDiv.querySelector('span').innerText} atingido.`);
                }
            });
        });

        document.querySelectorAll('.btn-quantidade-sub').forEach(button => {
            button.addEventListener('click', function () {
                const sizeOptionDiv = this.closest('.size-option');
                const quantidadeSpan = sizeOptionDiv.querySelector('.quantidade-ingrediente');
                let quantidade = parseInt(quantidadeSpan.innerText);
                const ingredientId = parseInt(sizeOptionDiv.getAttribute('data-ingredient-id'));

                if (quantidade > 0) {
                    quantidade--;
                    quantidadeSpan.innerText = quantidade;

                    let hiddenInput = sizeOptionDiv.querySelector(`.ingrediente-hidden[name='IngredientesManipuladasQuantidades[${ingredientId}]']`);
                    if (!hiddenInput) {
                         hiddenInput = document.createElement('input');
                         hiddenInput.type = 'hidden';
                         hiddenInput.classList.add('ingrediente-hidden');
                         hiddenInput.name = `IngredientesManipuladasQuantidades[${ingredientId}]`;
                         sizeOptionDiv.appendChild(hiddenInput);
                    }
                    hiddenInput.value = quantidade.toString();
                    
                    atualizarPrecoTotal();
                } else {
                    alert(`Não é possível ter menos de 0 unidades.`);
                }
            });
        });

        document.getElementById('personalizacaoForm').addEventListener('submit', function(event) {
            document.querySelectorAll('.size-option').forEach(function(div) {
                const quantidadeSpan = div.querySelector('.quantidade-ingrediente');
                const quantidade = parseInt(quantidadeSpan.innerText);
                const ingredientId = parseInt(div.getAttribute('data-ingredient-id'));
                
                let hiddenInput = div.querySelector(`.ingrediente-hidden[name='IngredientesManipuladasQuantidades[${ingredientId}]']`);
                if (!hiddenInput) {
                    hiddenInput = document.createElement('input');
                    hiddenInput.type = 'hidden';
                    hiddenInput.classList.add('ingrediente-hidden');
                    hiddenInput.name = `IngredientesManipuladasQuantidades[${ingredientId}]`;
                    div.appendChild(hiddenInput);
                }
                hiddenInput.value = quantidade.toString();
            });
        });

        atualizarPrecoTotal();
    });
</script>
</body>
</html>