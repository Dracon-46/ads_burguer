@model TotemPWA.ViewModels.PersonalizarProdutoViewModel
@{
    Layout = null;
    var tipo = Model.TipoProduto.ToLower();
}

<link rel="stylesheet" href="~/css/personalizarcombo.css" />

<div class="container">
    <button class="back-btn" onclick="history.back()">← Voltar</button>

    <div class="card">
        <div class="item-header">
            <img src="@Model.Produto.Image" alt="Produto" class="burger-img" />
            <div class="item-info">
                <h3>@Model.Produto.Name <span class="icon-editar">(@Model.TipoProduto)</span></h3>
                <p>@Model.Produto.Description</p>
                <p class="price">R$ @Model.Produto.Price.ToString("F2")</p>
            </div>
        </div>
    </div>

    @if (tipo == "lanche")
    {
        <div class="card">
           <div class="card">
                <h4>Ingredientes</h4>
                <div class="size-options">
                    @foreach (var ing in Model.Ingredientes)
                    {
                        <div class="size-option">
                            <span>@ing.Name</span>
                            <p>+ R$ @ing.Price.ToString("F2")</p>
                            <div>
                                <label>
                                    <input type="checkbox" name="IngredientesParaAdicionar" value="@ing.Id" />
                                    Adicionar
                                </label>
                                <label>
                                    <input type="checkbox" name="IngredientesParaRemover" value="@ing.Id" />
                                    Remover
                                </label>
                            </div>
                        </div>
                    }
                </div>
            </div>

        </div>
    }
    else if (tipo == "bebida")
    {
        <div class="card">
            <h4>Volume da Bebida</h4>
            <div class="size-options">
                @foreach (var volume in Model.Tamanhos)
                {
                    <div class="size-option" onclick="selecionarTamanho(this)">
                        <span>@volume</span>
                    </div>
                }
            </div>
        </div>
    }
    else if (tipo == "acompanhamento")
    {
        <div class="card">
            <h4>Tamanho do Acompanhamento</h4>
            <div class="size-options">
                @foreach (var tamanho in Model.Tamanhos)
                {
                    <div class="size-option" onclick="selecionarTamanho(this)">
                        <span>@tamanho</span>
                    </div>
                }
            </div>
        </div>
    }

    <div class="footer">
        <button class="cancel-btn" onclick="history.back()">Cancelar</button>
        <form method="post" asp-action="SalvarPersonalizacao" asp-controller="Customer">
            <input type="hidden" name="TipoProduto" value="@Model.TipoProduto" />
            <input type="hidden" name="ProdutoId" value="@Model.Produto.Id" />
            <input type="hidden" name="OrderItemId" value="@Model.OrderItemId" />
            <input type="text" name="TamanhoSelecionado" hidden /> <!-- preenche via radio/input se necessário -->
            <button type="submit" class="add-btn">Confirmar</button>
        </form>
    </div>
</div>

