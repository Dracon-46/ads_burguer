<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Inserir Cupom</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="/css/cupom.css">
</head>
<body>
    <div class="banner"></div>
    <div class="container">
        <h2>Digite abaixo o código do seu cupom:</h2>
        <input type="text" id="campoCupom" readonly><br>
        <button onclick="confirmarCupom()">Confirmar</button>
        <div class="keyboard" id="teclado"></div>
    </div>

    <!-- Modais -->
    <div class="modal" id="modalValido">
        <div class="modal-content">
            <span class="close" onclick="fecharModal('modalValido')">&times;</span>
            <i class="fa-solid fa-circle-check icon" style="color: #4CAF50;"></i>
            <p style="color: #4CAF50; font-weight: bold;">Cupom válido!</p> 
            <p id="mensagemCupomValido"></p> 
            <p>Aproveite seu desconto de <strong id="cupomValorExibicao"></strong>.</p>
        </div>
    </div>

    <div class="modal" id="modalInvalido">
        <div class="modal-content">
            <span class="close" onclick="fecharModal('modalInvalido')">&times;</span>
            <i class="fa-solid fa-circle-exclamation icon" style="color: #f44336;"></i>
            <p style="color: #f44336; font-weight: bold;">Cupom inválido</p>
            <p id="mensagemCupomInvalido"></p>
            <p>Verifique o código e tente novamente.</p>
        </div>
    </div>

    <div class="modal" id="modalVazio">
        <div class="modal-content">
            <span class="close" onclick="fecharModal('modalVazio')">&times;</span>
            <i class="fa-solid fa-triangle-exclamation icon" style="color: #FF9800;"></i>
            <p style="color: #FF9800; font-weight: bold;">Atenção</p>
            <p>Por favor, digite um código de cupom.</p>
        </div>
    </div>

    <!-- Resumo -->
    <div class="resumo-pedido">
        <div class="totais">
            <p>Total de itens: <strong id="totalItensDisplay">0</strong></p>
            <p>Total do pedido: <strong id="totalPedidoOriginalDisplay">R$ 0,00</strong></p>
            <p id="descontoAplicado" style="display: none;">Desconto: <strong id="valorDescontoDisplay">R$ 0,00</strong></p>
            <p id="totalPedidoFinalDiv" style="display: none;">Total com desconto: <strong id="totalPedidoFinalDisplay">R$ 0,00</strong></p>
        </div>
        <div class="botoes">
            <a href="@Url.Action("TelaProduto", "Home")"><button class="cancelar">Voltar</button></a>
            <a href="@Url.Action("SelecionarPagamento", "Payment")"><button class="adicionar">Confirmar Pedido</button></a>
        </div>
    </div>

    <script>
        const urlParams = new URLSearchParams(window.location.search);
        let totalPedidoOriginal = parseFloat(urlParams.get('totalPedido')) || 0;
        let totalItens = parseInt(urlParams.get('totalItens')) || 0;

        document.getElementById('totalItensDisplay').textContent = totalItens;
        document.getElementById('totalPedidoOriginalDisplay').textContent = totalPedidoOriginal.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });

        const teclas = "QWERTYUIOPASDFGHJKLZXCVBNM1234567890".split("");
        const teclado = document.getElementById("teclado");
        const campo = document.getElementById("campoCupom");

        window.onload = function () {
            teclas.forEach(t => {
                const tecla = document.createElement("div");
                tecla.className = "key";
                tecla.textContent = t;
                tecla.onclick = () => campo.value += t;
                teclado.appendChild(tecla);
            });

            const apagar = document.createElement("div");
            apagar.className = "key";
            apagar.style.background = "#f88";
            apagar.innerHTML = '<i class="fa-solid fa-delete-left" style="color: #FFF;"></i>';
            apagar.onclick = () => campo.value = campo.value.slice(0, -1);
            teclado.appendChild(apagar);

            const dadosCupomSalvo = JSON.parse(localStorage.getItem("dadosCupom")) || {};
            if (dadosCupomSalvo.codigo && dadosCupomSalvo.desconto > 0) {
                totalPedidoOriginal = dadosCupomSalvo.subtotal;
                document.getElementById('valorDescontoDisplay').textContent = dadosCupomSalvo.valorParaExibicao;
                document.getElementById('descontoAplicado').style.display = 'block';
                document.getElementById('totalPedidoFinalDisplay').textContent = dadosCupomSalvo.valorFinalComDesconto.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
                document.getElementById('totalPedidoFinalDiv').style.display = 'block';
                campo.value = dadosCupomSalvo.codigo;
            }
        };

        async function confirmarCupom() {
            const valorCupom = campo.value.trim().toUpperCase();

            if (valorCupom === "") {
                abrirModal("modalVazio");
                campo.style.borderColor = "";
                return;
            }

            try {
                const response = await fetch('/Home/ValidarCupom', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ codigoCupom: valorCupom })
                });

                const data = await response.json();

                if (data.isValid) {
                    abrirModal("modalValido");
                    document.getElementById('cupomValorExibicao').textContent = data.valorParaExibicao;
                    campo.style.borderColor = "green";

                    let valorDescontoCalculado = 0;
                    let totalComDesconto = totalPedidoOriginal;
                    const descontoValue = parseFloat(data.desconto);
                    const tipoDescontoLower = data.tipoDesconto.toLowerCase();

                    if (tipoDescontoLower === "percentual") {
                        valorDescontoCalculado = totalPedidoOriginal * descontoValue;
                    } else if (tipoDescontoLower === "fixo") {
                        valorDescontoCalculado = descontoValue;
                    }

                    totalComDesconto = Math.max(0, totalPedidoOriginal - valorDescontoCalculado);

                    document.getElementById('valorDescontoDisplay').textContent = valorDescontoCalculado.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
                    document.getElementById('descontoAplicado').style.display = 'block';
                    document.getElementById('totalPedidoFinalDisplay').textContent = totalComDesconto.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
                    document.getElementById('totalPedidoFinalDiv').style.display = 'block';

                    const dadosCupomParaSalvar = {
                        codigo: valorCupom,
                        desconto: valorDescontoCalculado,
                        tipoDesconto: data.tipoDesconto,
                        valorParaExibicao: data.valorParaExibicao,
                        subtotal: totalPedidoOriginal,
                        valorFinalComDesconto: totalComDesconto
                    };
                    localStorage.setItem("dadosCupom", JSON.stringify(dadosCupomParaSalvar));
                    localStorage.setItem("valorTotal", totalComDesconto.toFixed(2));

                } else {
                    abrirModal("modalInvalido");
                    document.getElementById('mensagemCupomInvalido').textContent = data.message;
                    campo.style.borderColor = "red";
                    document.getElementById('descontoAplicado').style.display = 'none';
                    document.getElementById('totalPedidoFinalDiv').style.display = 'none';
                    localStorage.removeItem("dadosCupom");
                    localStorage.setItem("valorTotal", totalPedidoOriginal.toFixed(2));
                }

            } catch (error) {
                console.error('Erro ao validar cupom:', error);
                abrirModal("modalInvalido");
                document.getElementById('mensagemCupomInvalido').textContent = "Erro na comunicação com o servidor.";
                campo.style.borderColor = "red";
                localStorage.removeItem("dadosCupom");
                localStorage.setItem("valorTotal", totalPedidoOriginal.toFixed(2));
            }
        }

        function abrirModal(id) {
            document.getElementById(id).style.display = "block";
        }

        function fecharModal(id) {
            document.getElementById(id).style.display = "none";
        }

        window.onclick = function (evento) {
            if (evento.target.className === "modal") {
                evento.target.style.display = "none";
            }
        }
    </script>
</body>
</html>
