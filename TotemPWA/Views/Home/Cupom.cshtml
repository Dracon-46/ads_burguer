@model TotemPWA.Controllers.CupomViewModel

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Inserir Cupom</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="/css/cupom.css">
</head>
<body>
    <div class="banner"></div>
    <div class="container">
        <h2>Digite abaixo o código do seu cupom:</h2>
        
        <form method="post" action="@Url.Action("ValidarCupom", "Home")">
            <input type="text" id="campoCupom" name="codigoCupom" readonly value="@(Model.CupomData?.Codigo ?? "")" required>
            <br>
            <div class="cupom-actions">
                <button type="submit" class="btn-confirmar">Confirmar</button>
                @if (Model.CupomData?.IsValid == true)
                {
                    <button type="submit" formaction="@Url.Action("RemoverCupom", "Home")" class="btn-remover">Remover Cupom</button>
                }
            </div>
        </form>
        
        <div class="keyboard" id="teclado"></div>
    </div>

    <!-- Alertas -->
    @if (TempData["CupomSucesso"] != null)
    {
        <div class="alert alert-success">
            <i class="fa-solid fa-circle-check"></i>
            @TempData["CupomSucesso"]
        </div>
    }

    @if (TempData["CupomErro"] != null)
    {
        <div class="alert alert-error">
            <i class="fa-solid fa-circle-exclamation"></i>
            @TempData["CupomErro"]
        </div>
    }

    @if (TempData["CupomInfo"] != null)
    {
        <div class="alert alert-info">
            <i class="fa-solid fa-info-circle"></i>
            @TempData["CupomInfo"]
        </div>
    }

    <!-- Resumo -->
    <div class="resumo-pedido">
        <div class="totais">
            <p>Total de itens: <strong>@Model.TotalItens</strong></p>
            <p>Subtotal: <strong>@Model.TotalPedido.ToString("C2", new System.Globalization.CultureInfo("pt-BR"))</strong></p>
            
            @if (Model.CupomData?.IsValid == true)
            {
                <p class="desconto-aplicado">
                    Desconto aplicado (@Model.CupomData.Codigo): 
                    <strong>-@Model.CupomData.Desconto.ToString("C2", new System.Globalization.CultureInfo("pt-BR"))</strong>
                </p>
                <p class="total-final">
                    Total final: 
                    <strong>@Model.CupomData.TotalComDesconto.ToString("C2", new System.Globalization.CultureInfo("pt-BR"))</strong>
                </p>
            }
            else
            {
                <p class="total-final">
                    Total do pedido: 
                    <strong>@Model.TotalPedido.ToString("C2", new System.Globalization.CultureInfo("pt-BR"))</strong>
                </p>
            }
        </div>
        <div class="botoes">
            <a href="@Url.Action("TelaProduto", "Home")">
                <button class="cancelar">Voltar</button>
            </a>
            <a href="@Url.Action("SelecionarPagamento", "Payment")">
                <button class="adicionar">Confirmar Pedido</button>
            </a>
        </div>
    </div>

    <script>
        const teclas = "QWERTYUIOPASDFGHJKLZXCVBNM1234567890".split("");
        const teclado = document.getElementById("teclado");
        const campo = document.getElementById("campoCupom");

        window.onload = function () {
            // Criar teclas do teclado virtual
            teclas.forEach(t => {
                const tecla = document.createElement("div");
                tecla.className = "key";
                tecla.textContent = t;
                tecla.onclick = () => {
                    campo.value += t;
                };
                teclado.appendChild(tecla);
            });

            // Botão apagar
            const apagar = document.createElement("div");
            apagar.className = "key";
            apagar.style.background = "#f88";
            apagar.innerHTML = '<i class="fa-solid fa-delete-left" style="color: #FFF;"></i>';
            apagar.onclick = () => {
                campo.value = campo.value.slice(0, -1);
            };
            teclado.appendChild(apagar);

            // Botão limpar
            const limpar = document.createElement("div");
            limpar.className = "key";
            limpar.style.background = "#ff6b6b";
            limpar.innerHTML = '<i class="fa-solid fa-trash" style="color: #FFF;"></i>';
            limpar.onclick = () => {
                campo.value = "";
            };
            teclado.appendChild(limpar);
        };

        // Auto-hide alerts after 5 seconds
        setTimeout(() => {
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(alert => {
                alert.style.opacity = '0';
                setTimeout(() => alert.remove(), 500);
            });
        }, 5000);
    </script>

    <style>
        .cupom-actions {
            display: flex;
            gap: 10px;
            margin-top: 10px;
        }

        .btn-confirmar {
            background: #4CAF50;
            color: white;
            padding: 12px 24px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-size: 16px;
            font-weight: 600;
        }

        .btn-remover {
            background: #f44336;
            color: white;
            padding: 12px 24px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-size: 16px;
            font-weight: 600;
        }

        .btn-confirmar:hover {
            background: #45a049;
        }

        .btn-remover:hover {
            background: #da190b;
        }

        .alert {
            position: fixed;
            top: 20px;
            right: 20px;
            padding: 15px 20px;
            border-radius: 8px;
            color: white;
            font-weight: 600;
            z-index: 1000;
            animation: slideIn 0.5s ease-out;
            max-width: 400px;
        }

        .alert-success {
            background: #4CAF50;
        }

        .alert-error {
            background: #f44336;
        }

        .alert-info {
            background: #2196F3;
        }

        .alert i {
            margin-right: 10px;
        }

        .desconto-aplicado {
            color: #4CAF50;
            font-weight: bold;
        }

        .total-final {
            font-size: 1.2em;
            font-weight: bold;
            color: #333;
            border-top: 2px solid #ddd;
            padding-top: 10px;
            margin-top: 10px;
        }

    </style>
</body>
</html>